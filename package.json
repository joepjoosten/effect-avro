{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "effect-tsgo tsrs -b tsconfig.json",
    "check-tsc": "tsc -b tsconfig.json",
    "check:examples": "pnpm build && tsc -p examples/tsconfig.json",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "changeset": "changeset",
    "changeset-version": "changeset version && pnpm install --lockfile-only",
    "changeset-publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "^0.67.5",
    "@effect/vitest": "4.1.3",
    "@types/node": "^26.6.6",
    "dprint": "^0.64.3",
    "effect": "4.1.3",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
