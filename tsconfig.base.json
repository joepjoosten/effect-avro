{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [],
  "compilerOptions": {
    // Use incremental builds with project references.
    "incremental": true,
    "composite": true,
    // Target modern JavaScript (ES2022+) whilst staying closely compatible with the Node.js module system.
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force", // Treat every non-declaration file as a module.
    "verbatimModuleSyntax": true, // Only transform/eliminate type-only import/export statements.
    "isolatedModules": true,
    "allowJs": false,
    "rewriteRelativeImportExtensions": true, // Rewrite `.ts` imports to `.js` at build time.
    "erasableSyntaxOnly": true, // Allows to run directly with node and type removal
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Emit declarations, source- & declaration maps.
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "noEmitOnError": false,
    // Opt-in to stricter type checking and correctness guard rails.
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // Miscellaneous
    "skipLibCheck": true, // Skip type checking of third party libraries.
    "noErrorTruncation": true, // Do not truncate error messages.
    "types": [], // Disable automatic loading of `@types/*` packages.
    "plugins": [{
      "name": "@effect/language-service",
      "effectFn": ["untraced"],
      "namespaceImportPackages": ["effect", "@effect/*"],
      "diagnosticSeverity": {
        "globalErrorInEffectFailure": "off",
        "unstableApiUsage": "off",
        "experimentalApiUsage": "off",
        "effectFnOpportunity": "error"
      },
      "includeSuggestionsInTsc": false,
      "ignoreEffectWarningsInTscExitCode": true,
      "ignoreEffectErrorsInTscExitCode": false,
      "overrides": [
        {
          "exclude": [
            "**/internal/**/*",
            "**/index.ts",
            "**/test/**/*",
            "**/examples/**/*"
          ],
          "options": {
            "diagnosticSeverity": {
              "apiStabilityLeak": "error"
            }
          }
        }
      ]
    }],
    // Paths are relative to this file (no baseUrl).
    "paths": {
      "@effect-avro/core": ["./packages/core/src/index.ts"],
      "@effect-avro/core/*": ["./packages/core/src/*.ts"],
      "@effect-avro/kafka": ["./packages/kafka/src/index.ts"],
      "@effect-avro/kafka/*": ["./packages/kafka/src/*.ts"],
      "@effect-avro/node": ["./packages/node/src/index.ts"],
      "@effect-avro/node/*": ["./packages/node/src/*.ts"],
      "@effect-avro/schema": ["./packages/schema/src/index.ts"],
      "@effect-avro/schema/*": ["./packages/schema/src/*.ts"],
      "@effect-avro/schema-registry": ["./packages/schema-registry/src/index.ts"],
      "@effect-avro/schema-registry/*": ["./packages/schema-registry/src/*.ts"]
    }
  }
}
